# Mercado Pago
MP_ACCESS_TOKEN=REEMPLAZAR_EN_SERVIDOR
MP_WEBHOOK_SECRET=REEMPLAZAR_EN_SERVIDOR
MP_WEBHOOK_URL=
MP_CURRENCY_ID=ARS
MP_SUCCESS_URL=
MP_FAILURE_URL=
MP_PENDING_URL=

# Base de datos PostgreSQL (local o Supabase). Sin DATABASE_URL se usa SQLite local.
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/transcriber

# Auth JWT (30 dias para app de escritorio)
JWT_SECRET_KEY=REEMPLAZAR_EN_SERVIDOR_CON_MINIMO_32_CARACTERES
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Groq: SOLO servidor
GROQ_API_KEY_SERVER=REEMPLAZAR_EN_SERVIDOR

# Creditos
DEFAULT_INITIAL_CREDITS=60
CREDITS_PER_MINUTE=1
CREDIT_PACKAGES_JSON=

# Limits
BACKEND_MAX_UPLOAD_BYTES=2147483648
GROQ_FREE_MAX_BYTES=26214400
GROQ_MAX_WORKERS=3
GROQ_MAX_RETRIES=5
CORS_ORIGINS=http://localhost,http://127.0.0.1
